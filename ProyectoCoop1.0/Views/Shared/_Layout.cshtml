<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoCoop1._0</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logocoop.png" alt="Logo" style="height: 30px; margin-right: 10px;" />
                    ProyectoCoop1.0
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Privacy">Institucional</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <!-- Links para admin -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="Socios" asp-action="Index">Socios</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="Turnoes" asp-action="Index">Turnos reservados</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold text-primary" asp-controller="Turnoes" asp-action="Finalizados">Turnos Finalizados</a>
                                </li>
                            }
                            else if (User.IsInRole("Socio"))
                            {
                                <!-- Links para socio -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="Turnoes" asp-action="CreateTurnoSocio">Sacar turno</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="Turnoes" asp-action="TurnosSuspendidos">
                                        Turnos Suspendidos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="Turnoes" asp-action="MisTurnos">
                                        Mis Turnos
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Usuarios" asp-action="Logout" method="post" class="d-flex">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link nav-link">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link text-success" asp-area="" asp-controller="Usuarios" asp-action="Login">Iniciar Sesión</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
