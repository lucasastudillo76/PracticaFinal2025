@model ProyectoCoop1._0.Models.Turno

@{
    ViewData["Title"] = "Sacar Turno";
}

<h2>Sacar Turno</h2>
<p><b>Porfavor seleccionar un dia habil(*LUNES A VIERNES*) y entre las 7AM Hasta 12PM</b></p>
<hr />

@if (TempData["TurnoReservado"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["TurnoReservado"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="CreateTurnoSocio" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Fecha y Hora -->
            <div class="form-group">
                <label asp-for="FechaHora" class="control-label"></label>
                <input asp-for="FechaHora" id="fechaHora" class="form-control" type="datetime-local" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="FechaHora" class="text-danger"></span>
            </div>

            <!-- Servicio -->
            <div class="form-group">
                <label asp-for="servicio" class="control-label">Servicio</label>
                <select asp-for="servicio" class="form-control" id="servicio" name="servicio">
                    <option value="">-- Seleccione un servicio --</option>
                    <option value="internet">Internet</option>
                    <option value="cablevision">Cablevisión Digital</option>
                    <option value="telefono">Teléfono</option>
                    <option value="energia">Energia Electrica</option>
                    <option value="agua">Agua Corriente</option>
                    <option value="sociales">Servicios Sociales</option>
                </select>
                <span asp-validation-for="servicio" class="text-danger"></span>
            </div>

            <!-- Tarea -->
            <div class="form-group">
                <label asp-for="tarea" class="control-label">Tarea</label>
                <select asp-for="tarea" class="form-control" id="tarea" name="tarea">
                    <option value="">-- Seleccione una tarea --</option>
                </select>
                <span asp-validation-for="tarea" class="text-danger"></span>
            </div>

            <!-- Estado -->
            <div class="form-group">
                <label asp-for="estado" class="control-label"></label>
                <select asp-for="estado" class="form-control">
                    <option value="Pendiente" selected>Pendiente</option>
                </select>
                <span asp-validation-for="estado" class="text-danger"></span>
            </div>

            <!-- Botón -->
            <div class="form-group mt-3">
                <input type="submit" value="Confirmar Turno" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        const tareasPorServicio = {
            internet: ["Colocación de fibra", "Sin internet", "Interrupciones de servicio"],
            telefono: ["Sin tono", "Con ruido"],
            cablevision: ["Conectar servicio de TV", "No se puede reproducir contenido", "Conectar 1 STB adicional", "Conectar 2 STB adicional"],
            energia: ["Conectar Servicio de Energia", "Sin luz", "Reemplazar medidor por prepago", "Reemplazar medidor por convencional"],
            agua: ["Sin agua", "Falta presion", "Caño roto", "Perdida de agua"],
            sociales: ["Traslado en ambulancia", "Solicitud de ortopedia"]
        };

        function cargarTareas(servicio) {
            const tareaSelect = document.getElementById("tarea");
            tareaSelect.innerHTML = '<option value="">-- Seleccione una tarea --</option>';

            if (tareasPorServicio[servicio]) {
                tareasPorServicio[servicio].forEach(function (tarea) {
                    const option = document.createElement("option");
                    option.value = tarea;
                    option.text = tarea;
                    tareaSelect.appendChild(option);
                });
            }
        }

        const servicioSelect = document.getElementById("servicio");

        servicioSelect.addEventListener("change", function () {
            cargarTareas(this.value);
        });

        window.addEventListener("load", function () {
            const servicioActual = document.getElementById("servicio").value;
            const tareaActual = "@Model.tarea";

            if (servicioActual) {
                cargarTareas(servicioActual);

                if (tareaActual) {
                    const tareaSelect = document.getElementById("tarea");
                    const optionToSelect = Array.from(tareaSelect.options).find(o => o.value === tareaActual);
                    if (optionToSelect) optionToSelect.selected = true;
                }
            }
        });

        // Validaciones JS
        const inputFecha = document.querySelector("input[type='datetime-local']");
        const form = document.querySelector("form");

        form.addEventListener("submit", function (e) {
            const [datePart, timePart] = inputFecha.value.split("T");

            if (!datePart || !timePart) return;

            const [year, month, day] = datePart.split("-").map(Number);
            const [hour, minute] = timePart.split(":").map(Number);

            const fecha = new Date(year, month - 1, day, hour, minute);
            const ahora = new Date();
            const dia = fecha.getDay(); // 0 = domingo, 6 = sábado
            let mensaje = "";

            if (fecha <= ahora) mensaje += "La fecha debe ser posterior a la actual.\n";
            if (dia === 0 || dia === 6) mensaje += "Debe ser un día hábil (lunes a viernes).\n";
            if (hour < 7 || hour > 12) mensaje += "Hora inválida. Debe ser entre 07:00 y 12:00.\n";
            if (minute !== 0) mensaje += "Solo se permiten turnos en horas exactas (ej: 07:00, 08:00, etc.).\n";

            if (mensaje) {
                e.preventDefault();
                alert(mensaje.trim());
            }
        });
    </script>
}
