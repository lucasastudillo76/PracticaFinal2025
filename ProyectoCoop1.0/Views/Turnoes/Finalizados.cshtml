@model IEnumerable<ProyectoCoop1._0.Models.Turno>

@{
    ViewData["Title"] = "Turnos Finalizados";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary fw-bold">@ViewData["Title"]</h2>

    <!-- Formulario de búsqueda -->
    <form method="get" asp-action="Finalizados" class="row g-3 align-items-center mb-4">
        <div class="col-auto">
            <label for="filtroApellido" class="col-form-label">Buscar por Apellido:</label>
        </div>
        <div class="col-md-4">
            <input type="text" name="filtroApellido" id="filtroApellido" class="form-control"
                   value="@ViewBag.FiltroApellido" placeholder="Ej: Pérez" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>

    <!-- Tabla de turnos finalizados -->
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Servicio</th>
                    <th>Tarea</th>
                    <th>Socio</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FechaHora.ToString("g")</td>
                            <td>@item.servicio</td>
                            <td>@item.tarea</td>
                            <td>@item.Socio?.nombre @item.Socio?.apellido</td>
                            <td>
                                @if (item.estado == "Cancelado")
                                {
                                    <span class="badge bg-danger">@item.estado</span>
                                }
                                else if (item.estado == "Finalizado")
                                {
                                    <span class="badge bg-success">@item.estado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.estado</span>
                                }
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No hay turnos finalizados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Botón de volver -->
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle"></i> Volver
        </a>
    </div>
</div>
