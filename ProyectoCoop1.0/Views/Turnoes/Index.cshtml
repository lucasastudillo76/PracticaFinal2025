@model IEnumerable<ProyectoCoop1._0.Models.Turno>

@{
    ViewData["Title"] = "Turnos Reservados";
}

<h2>Turnos Reservados</h2>

<table class="table table-bordered table-hover align-middle">
    <thead>
        <tr>
            <th>Fecha y Hora</th>
            <th>Servicio</th>
            <th>Tarea</th>
            <th>Estado</th>
            <th>Socio</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No hay turnos reservados.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.servicio</td>
                <td>@item.tarea</td>
                <td>@item.estado</td>
                <td>@item.Socio?.nombre @item.Socio?.apellido</td>
                <td>@item.Socio?.email</td>
                <td>@item.Socio?.telefono</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.id" class="btn btn-sm btn-info">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
       
            }
            }
        
      
    </tbody>
</table>
