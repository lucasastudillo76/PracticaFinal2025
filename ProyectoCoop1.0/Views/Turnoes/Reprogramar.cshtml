@model ProyectoCoop1._0.Models.Turno

@{
    ViewData["Title"] = "Reprogramar Turno";
}

<h2>Reprogramar Turno</h2>

<form asp-action="Reprogramar" method="post">
    <input type="hidden" asp-for="id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="FechaHora" class="control-label"></label>
        <input asp-for="FechaHora" class="form-control" type="datetime-local"
               value="@Model.FechaHora.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="FechaHora" class="text-danger"></span>
        <input type="hidden" asp-for="servicio" />
        <input type="hidden" asp-for="tarea" />
        <input type="hidden" asp-for="estado" />
    </div>    

    <button type="submit" class="btn btn-success">Confirmar</button>
    <a asp-action="TurnosSuspendidos" class="btn btn-secondary">Cancelar</a>
</form>
@if (ViewBag.MensajeReprogramacion != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ViewBag.MensajeReprogramacion
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}


@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")

    <script> 

        const inputFecha = document.querySelector("input[type='datetime-local']");
        const form = document.querySelector("form");

        form.addEventListener("submit", function (e) {
            const [datePart, timePart] = inputFecha.value.split("T");

            if (!datePart || !timePart) return;

            const [year, month, day] = datePart.split("-").map(Number);
            const [hour, minute] = timePart.split(":").map(Number);

            const fecha = new Date(year, month - 1, day, hour, minute);
            const ahora = new Date();

            const dia = fecha.getDay(); // 0 = domingo, 6 = sábado

            let mensaje = "";

            if (fecha <= ahora) {
                mensaje += "La fecha debe ser posterior a la actual.\n";
            }

            if (dia === 0 || dia === 6) {
                mensaje += "Debe ser un día hábil (lunes a viernes).\n";
            }

            if (hour < 7 || hour > 11) {
                mensaje += "Hora inválida. Debe ser entre 07:00 y 11:00.\n";
            }

            if (mensaje) {
                e.preventDefault(); // 🚫 Evita que el formulario se envíe
                alert(mensaje.trim());
            }
        });
    </script>
}


