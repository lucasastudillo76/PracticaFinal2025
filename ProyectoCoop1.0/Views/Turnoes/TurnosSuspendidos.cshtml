@model IEnumerable<Turno>

<h2>Turnos Suspendidos</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Servicio</th>
            <th>Tarea</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center">No hay turnos Suspendidos.</td>
            </tr>
        }      
    </tbody>
</table>
